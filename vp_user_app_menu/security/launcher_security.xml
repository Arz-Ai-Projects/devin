<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data recursive="1">
        <record id="module_category_vp_launcher" model="ir.module.category">
            <field name="name">User App Launcher</field>
            <field name="description">Manage user app launcher folders, templates, and configurations.</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_vp_launcher_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_vp_launcher"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Standard user access to App Launcher personal settings.</field>
        </record>

        <record id="group_vp_launcher_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_vp_launcher"/>
            <field name="implied_ids" eval="[(4, ref('group_vp_launcher_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Full administrator access to manage App Launcher global folders, roles, and user templates.</field>
        </record>

        <!-- Record Rules -->
        <record id="rule_vp_launcher_user_config_own" model="ir.rule">
            <field name="name">User Config: Read/Write Own</field>
            <field name="model_id" ref="model_vp_launcher_user_config"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_vp_launcher_user_config_admin" model="ir.rule">
            <field name="name">User Config: Admin All</field>
            <field name="model_id" ref="model_vp_launcher_user_config"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_vp_launcher_admin'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
    </data>
</odoo>
