<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Role List View -->
    <record id="view_vp_launcher_role_tree" model="ir.ui.view">
        <field name="name">vp.launcher.role.list</field>
        <field name="model">vp.launcher.role</field>
        <field name="arch" type="xml">
            <list string="Launcher Role Templates">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="group_ids" widget="many2many_tags"/>
                <field name="folder_ids" widget="many2many_tags"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Role Form View -->
    <record id="view_vp_launcher_role_form" model="ir.ui.view">
        <field name="name">vp.launcher.role.form</field>
        <field name="model">vp.launcher.role</field>
        <field name="arch" type="xml">
            <form string="Launcher Role Template">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Role Name (e.g. Sales User, Warehouse Manager)"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="group_ids" widget="many2many_tags" placeholder="Target Odoo Security Groups..."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Assigned Folders" name="folders">
                            <field name="folder_ids" widget="many2many">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="icon"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Role Action -->
    <record id="action_vp_launcher_role" model="ir.actions.act_window">
        <field name="name">Launcher Roles</field>
        <field name="res_model">vp.launcher.role</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define role templates mapping Odoo groups to specific launcher folders!
            </p>
        </field>
    </record>
</odoo>
