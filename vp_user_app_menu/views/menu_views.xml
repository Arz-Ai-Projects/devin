<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Launcher Client Action -->
    <record id="action_app_launcher" model="ir.actions.client">
        <field name="name">App Launcher</field>
        <field name="tag">vp_user_app_menu.AppLauncher</field>
        <field name="target">main</field>
    </record>

    <!-- Settings Root Menu for User App Launcher -->
    <menuitem id="menu_vp_launcher_root"
              name="User App Launcher"
              parent="base.menu_administration"
              sequence="80"
              groups="group_vp_launcher_admin"/>

    <!-- Menu Items under User App Launcher -->
    <menuitem id="menu_vp_launcher_folders"
              name="Folders"
              parent="menu_vp_launcher_root"
              action="action_vp_launcher_folder"
              sequence="10"/>

    <menuitem id="menu_vp_launcher_roles"
              name="Roles"
              parent="menu_vp_launcher_root"
              action="action_vp_launcher_role"
              sequence="20"/>

    <menuitem id="menu_vp_launcher_user_configs"
              name="User Configurations"
              parent="menu_vp_launcher_root"
              action="action_vp_launcher_user_config"
              sequence="30"/>
</odoo>
