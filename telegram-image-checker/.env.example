# --- Telegram user account (MTProto) ---------------------------------------
# Get these from https://my.telegram.org  ->  API development tools
API_ID=1234567
API_HASH=your_api_hash_here
# Phone number of the user account, international format (e.g. +971500000000).
# The account MUST be a member of TARGET_CHANNEL so it can read history.
PHONE=+10000000000

# --- Bot (the DM interface) ------------------------------------------------
# Create a bot with @BotFather and paste the token here.
BOT_TOKEN=123456:ABC-DEF...

# --- What to index ---------------------------------------------------------
# The channel/group to scan. Accepts:
#   - a public @username        (e.g. @mychannel)
#   - an invite/username link   (e.g. https://t.me/mychannel)
#   - a numeric id              (e.g. -1001234567890)
TARGET_CHANNEL=@your_channel

# --- Matching / behaviour --------------------------------------------------
# Max perceptual-hash Hamming distance (0-64) still considered "similar".
# 0 = identical looking, ~8 = good default, higher = looser matches.
PHASH_THRESHOLD=8
# Max number of matches to return in a reply.
MAX_RESULTS=5

# --- Storage ---------------------------------------------------------------
DB_PATH=index.db

# --- Access control (optional) ---------------------------------------------
# Numeric Telegram user id allowed to run /reindex. Leave blank to allow anyone.
ADMIN_USER_ID=
